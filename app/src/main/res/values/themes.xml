<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RePixIV" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/is_light_mode</item>
        <item name="bottomNavigationStyle">@style/MiuixBottomNav</item>
    </style>

    <!-- miuix NavigationBar exact spec:
         ItemHeight=64dp, IconSize=26dp, LabelFontSize=12sp,
         IconTopPadding=8dp, BottomPadding=8dp, UnselectedAlpha=0.4 -->
    <style name="MiuixBottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/NavNoIndicator</item>
        <item name="elevation">0dp</item>
        <item name="itemIconSize">26dp</item>
        <!-- itemPaddingTop / itemPaddingBottom control space above icon and below text.
             Setting both to 8dp matches miuix IconTopPadding=8dp + BottomPadding=8dp,
             which pulls the text visually close to the icon (no extra dead space). -->
        <item name="itemPaddingTop">8dp</item>
        <item name="itemPaddingBottom">8dp</item>
        <item name="itemTextAppearanceActive">@style/NavTextActive</item>
        <item name="itemTextAppearanceInactive">@style/NavTextInactive</item>
    </style>

    <style name="NavNoIndicator" parent="">
        <item name="android:color">@android:color/transparent</item>
        <item name="android:height">0dp</item>
    </style>

    <!-- miuix: bold for selected, normal for unselected, 12sp (LabelFontSize) -->
    <style name="NavTextActive">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="NavTextInactive">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
    </style>
</resources>
