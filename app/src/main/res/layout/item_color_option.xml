<?xml version="1.0" encoding="utf-8"?>
<!-- miuix DropdownImpl popup row:
     InsideHorizontalPadding=20dp, MiddleVerticalPadding=12dp (top+bottom),
     container adds 8dp top/bottom so first/last effectively gets 20dp (FirstLastVerticalPadding)
     CheckIconSize=20dp, CheckIconStartPadding=12dp -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="32dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="?attr/selectableItemBackground">

    <TextView
        android:id="@+id/textOption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:textSize="16sp"
        android:maxLines="1"/>

    <!-- miuix Check icon: CheckIconSize=20dp, right-side, selectedIndicatorColor=primary -->
    <ImageView
        android:id="@+id/iconCheck"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginStart="12dp"
        android:src="@drawable/ic_check_blue"
        android:contentDescription="@null"
        android:visibility="gone"/>

</FrameLayout>
