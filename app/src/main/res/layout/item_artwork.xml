<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <ImageView android:id="@+id/imageAvatar"
            android:layout_width="40dp" android:layout_height="40dp"
            android:contentDescription="@string/author_avatar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView android:id="@+id/textAuthorName"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imageAvatar"
            app:layout_constraintTop_toTopOf="@id/imageAvatar"/>

        <TextView android:id="@+id/textTitle"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="@color/text_secondary" android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imageAvatar"
            app:layout_constraintTop_toBottomOf="@id/textAuthorName"/>

        <ImageView android:id="@+id/imageArtwork"
            android:layout_width="0dp" android:layout_height="220dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/artwork_image"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imageAvatar"/>

        <TextView android:id="@+id/textTags"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/accent" android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imageArtwork"/>

        <ImageView android:id="@+id/iconHeart"
            android:layout_width="20dp" android:layout_height="20dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/ic_heart"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textTags"/>

        <TextView android:id="@+id/textLikeCount"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:textColor="@color/text_secondary" android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="@id/iconHeart"
            app:layout_constraintStart_toEndOf="@id/iconHeart"
            app:layout_constraintTop_toTopOf="@id/iconHeart"/>

        <ImageView android:id="@+id/iconEye"
            android:layout_width="18dp" android:layout_height="18dp"
            android:layout_marginStart="18dp"
            android:src="@drawable/ic_eye"
            app:layout_constraintBottom_toBottomOf="@id/iconHeart"
            app:layout_constraintStart_toEndOf="@id/textLikeCount"
            app:layout_constraintTop_toTopOf="@id/iconHeart"/>

        <TextView android:id="@+id/textViewCount"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:textColor="@color/text_secondary" android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="@id/iconHeart"
            app:layout_constraintStart_toEndOf="@id/iconEye"
            app:layout_constraintTop_toTopOf="@id/iconHeart"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
